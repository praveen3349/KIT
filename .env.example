# College system (given at the hackathon). Keep this private: never commit your real .env file.
COLLEGE_API_URL=https://ht.knowvally.com
COLLEGE_API_KEY=paste-your-kit_live-key-here

# Free key from https://console.groq.com/keys (chat, speech-to-text, text-to-speech)
GROQ_API_KEY=paste-your-groq-key-here
SESSION_SECRET=generate-a-long-random-production-secret

TIMEZONE=Asia/Kolkata

# Optional overrides
# CHAT_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# STT_MODELS=whisper-large-v3-turbo,whisper-large-v3
# STT_LANGUAGE=en
# TTS_PROVIDER=groq        # or "browser" to always use the browser's built-in voice
# TTS_VOICE=hannah
